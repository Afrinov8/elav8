# Neon Postgres connection string (get this from your Neon project dashboard)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign session JWTs — generate with `openssl rand -hex 32`
JWT_SECRET=change-me

# Port the local API server listens on
PORT=3000

# Set this to your `expo start --tunnel` API URL when testing on a physical
# device via Expo Go, e.g. https://xxxx.exp.direct:3000 or an ngrok URL.
# Leave unset to auto-derive from the Metro dev server host (works for
# simulators/emulators on the same machine).
# EXPO_PUBLIC_API_URL=
